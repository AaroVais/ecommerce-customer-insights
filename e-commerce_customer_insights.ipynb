   ],
   "source": [
    "plot_data = df_B2C.groupby([\"ABC_category\", \"RFM_categories\"]).size().unstack(fill_value=0)\n",
    "\n",
    "\n",
    "\n",
    "colors=[\"#1A3A5A\", \"#4A90E2\", \"#D1E5F4\", \"#1A3A5A\", \"#4A90E2\", \"#D1E5F4\"]  \n",
    "\n",
    "ax = plot_data.plot(kind='barh', stacked=True, figsize=(10, 7), color=colors)\n",
    "plt.xlabel(\"Customers [qty]\")\n",
    "ax.get_legend().remove()\n",
    "ax.set_ylabel(\"\")\n",
    "ax.tick_params(axis='y', labelsize=20)\n",
    "for container in ax.containers:\n",
    "    labels = [f'{v.get_width():.0f}' if v.get_width() > 0 else \"\" for v in container]\n",
