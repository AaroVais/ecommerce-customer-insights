     ]
    }
   ],
   "source": [
    "df_filtered=df_customers[age_mask].copy()\n",
    "print(df_filtered.describe())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e21ec371-d68d-4243-a4a9-40ed813002d8",
   "metadata": {},
   "source": [
    "We are left with 9300 customers with age range of 18-79 and min spent of 0.85 and max spent of 257773. Next we have to convert every total spent to same currency Euro. Let's check how many times different currencies appear on the data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "82b93ea6-795f-46a6-bfd4-3060bb2f72b5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Currency\n",
      "USD     2786\n",
      "USDT    2738\n",
      "EUR     1904\n",
      "GBP     1873\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "currencies_counts=df_filtered[\"Currency\"].value_counts()\n",
    "print(currencies_counts)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4a8602ce-9397-4435-8ead-d426db4e5fd5",
   "metadata": {},
   "source": [
    "Lets convert everything to euros. Source: European Central Bank (19.3.2026)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "de104167-f0c4-4dc1-a585-e82cb0196ce7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "count      9301.000000\n",
       "mean       6252.051942\n",
       "std       24109.241905\n",
       "min           0.985614\n",
       "25%         671.670405\n",
       "50%         980.339835\n",
       "75%        1349.698744\n",
       "max      257773.516486\n",
       "Name: TotalSpentEUR, dtype: float64"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "#Convertion rates as dictionary.\n",
    "convertion_rates={\n",
    "    \"USD\":1/1.1489,\n",
    "    \"USDT\":1/1.1489,\n",
    "    \"EUR\":1.0,\n",
    "    \"GBP\":1/0.86388 \n",
    "}\n",
    "#Lets add new \"TotalSpentEUR\" column to our dataframe.\n",
    "df_filtered[\"TotalSpentEUR\"]=df_filtered[\"TotalSpent\"]*df_filtered[\"Currency\"].map(convertion_rates)\n",
    "df_filtered[\"TotalSpentEUR\"].describe()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f826e8e2-af2e-4274-98f0-8a3f535e8842",
   "metadata": {},
   "source": [
    "Lets make abc-analysis based on the TotalSpentEUR column."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "b9b433ce-20e2-4012-8194-467fb15d1058",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "9727    0.443288\n",
       "3192    0.843211\n",
       "9215    1.199504\n",
       "3436    1.544155\n",
       "2809    1.883119\n",
       "8128    2.220474\n",
       "3172    2.556466\n",
       "9044    2.891945\n",
       "9875    3.223597\n",
       "4128    3.552247\n",
       "Name: Cumulative_%, dtype: float64"
      ]
     },
     "execution_count": 9,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "#Lets sort data on descending order.\n",
    "df_filtered=df_filtered.sort_values(by=\"TotalSpentEUR\", ascending=False)\n",
    "#Next we need to calculate cumulative sum.\n",
    "df_filtered[\"Cumulative_sum\"]=df_filtered[\"TotalSpentEUR\"].cumsum()\n",
    "#Lets calculate cumulative % from whole sum.\n",
    "whole_sum=df_filtered[\"TotalSpentEUR\"].sum()\n",
    "df_filtered[\"Cumulative_%\"]=(df_filtered[\"Cumulative_sum\"]/whole_sum)*100\n",
    "df_filtered[\"Cumulative_%\"].head(10)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "723ad755-a93f-4ded-b0c7-1ba2a7590998",
   "metadata": {},
   "source": [
    "Next we need to divide the customers into a, b and c categories based on the cumulative_%. First 80% goes to class A, next 15% to class B and last 5% to class C.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "1ae0114d-4a64-4fe8-8599-03b1d2774cec",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ABC_category\n",
      "C    4630\n",
      "B    4248\n",
      "A     423\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "#Lets make a funktion to do the classification.\n",
    "def ABC_classification (percentage):\n",
    "    if percentage <= 80:\n",
    "        return \"A\"\n",
    "    elif percentage <= 95:\n",
    "        return \"B\"\n",
    "    else:\n",
    "        return \"C\"\n",
    "#lets add a ABC category column to the dataframe.\n",
    "df_filtered[\"ABC_category\"]=df_filtered[\"Cumulative_%\"].apply(ABC_classification)\n",
    "print(df_filtered[\"ABC_category\"].value_counts())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "64b55e17-4904-4c18-9939-e7eca5513621",
   "metadata": {},
   "source": [
    "We can see that very small portion of the customers bring 80% of the revenue. They are most likely B2B customers. Next we need to divide B2B and B2C customers to their own dataframes. We can do the dividing using credit column. We can assume that B2C customers are marked as 'Instant' in the payment column, as credit for consumers is typically issued by banks rather than the e-commerce platform itself."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "cbbf49fb-ae10-4475-8c91-187487e9273b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
