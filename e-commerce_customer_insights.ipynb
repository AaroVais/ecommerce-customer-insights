      "4    629\n",
      "2    629\n",
      "5    628\n",
      "1    624\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "#Lets calculate recency scores and make a column for them.\n",
    "df_B2C[\"R_score\"], RbordersB2C=pd.qcut(df_B2C[\"Recency\"], q=5, labels=[5, 4, 3, 2, 1], retbins=True)\n",
    "print(\"B2C:\")\n",
    "print(RbordersB2C)\n",
    "print(df_B2C[\"R_score\"].value_counts())\n",
    "df_B2B[\"R_score\"], RbordersB2B=pd.qcut(df_B2B[\"Recency\"], q=5, labels=[5, 4, 3, 2, 1], retbins=True)\n",
    "print(\"B2B:\")\n",
    "print(RbordersB2B)\n",
    "print(df_B2B[\"R_score\"].value_counts())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "46d751b4-4e1d-40dd-9349-1f299b76d42c",
   "metadata": {},
   "source": [
    "Now every customer is divided to R_score groups. Each group contains aproximately 20% of total customers from that group. Next we can define frequency scores."
