   "source": [
    "#Lets divide the dataframe to B2C customers and B2B customers.\n",
    "df_B2C=df_filtered[(df_filtered[\"PaymentType\"] == \"Instant\") & (df_filtered[\"TotalSpentEUR\"]<10000)].copy()\n",
    "df_B2B=df_filtered[(df_filtered[\"PaymentType\"] == \"Credit\") | (df_filtered[\"TotalSpentEUR\"]>=10000)].copy()\n",
