    "print(df_B2B[\"LastPurchaseDate\"].min())\n",
    "print(df_B2B[\"LastPurchaseDate\"].max())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3adca9dc-2b6f-423c-9955-0806c8e94108",
   "metadata": {},
   "source": [
    "Both groups have the same timeframe, so we can use same snapshot date for both. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "7e44adf5-6923-46ba-8640-405d207a9b89",
   "metadata": {},
