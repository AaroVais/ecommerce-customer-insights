       "Instant    6520\n",
       "Credit     2781\n",
       "Name: count, dtype: int64"
      ]
     },
     "execution_count": 11,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df_filtered[\"PaymentType\"].value_counts(dropna=False)"
   ]
  },
  {
