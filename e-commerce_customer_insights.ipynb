   "source": [
    "Next we can make the RFM graphs. Lets start with B2C"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "2aa945ac-8513-4634-b308-5a06e6338864",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
