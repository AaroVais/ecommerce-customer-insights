      "Name: Recency, dtype: float64\n"
     ]
    }
   ],
   "source": [
    "#Lets define our snapshot date (latest purchase +1day)\n",
    "snapshot_date=df_B2C[\"LastPurchaseDate\"].max()+ pd.Timedelta(days=1)\n",
    "#Lets calculate recency column by compairing LastPurchaseDate to snapshot_date\n",
    "df_B2C[\"Recency\"]=snapshot_date-df_B2C[\"LastPurchaseDate\"]\n",
    "df_B2B[\"Recency\"]=snapshot_date-df_B2B[\"LastPurchaseDate\"]\n",
    "#We need to convert recency to show only days\n",
    "df_B2C[\"Recency\"]=df_B2C[\"Recency\"].dt.days\n",
    "print(\"B2C:\")\n",
    "print(df_B2C[\"Recency\"].describe())\n",
    "df_B2B[\"Recency\"]=df_B2B[\"Recency\"].dt.days\n",
    "print(\"B2B:\")\n",
    "print(df_B2B[\"Recency\"].describe())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d1a58d80-1a3c-4fb9-82b1-dcf3ad4b8fc0",
   "metadata": {},
   "source": [
    "Recency columns looks good. Next we want to convert it to Recency score from 1 to 5."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "45087f3c-143d-4d55-91c4-7e984e66cddf",
   "metadata": {},
