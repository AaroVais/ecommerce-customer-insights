  },
  {
   "cell_type": "markdown",
   "id": "25817704-e541-482f-a76a-9c0d6cccd92d",
   "metadata": {},
   "source": [
    "We can see that our platforms most important clients are all companies. Next we define three categories to analyze customer behavior more closely within the ABC classes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "b3d0a561-97da-4208-bea1-8862f63881a6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "B2C:\n",
      "RFM_categories\n",
      "C:passive         1319\n",
      "C:Active_LowF     1239\n",
      "B:Active_LowF     1151\n",
      "B:passive         1148\n",
      "C:Active_HighF     720\n",
      "B:Active_HighF     584\n",
      "Name: count, dtype: int64\n",
      "B2B:\n",
      "RFM_categories\n",
      "C:passive         550\n",
      "B:passive         540\n",
      "C:Active_LowF     531\n",
      "B:Active_LowF     513\n",
      "B:Active_HighF    312\n",
      "C:Active_HighF    271\n",
      "A:passive         167\n",
      "A:Active_LowF     160\n",
      "A:Active_HighF     96\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "#Lets define conditions for the categories.\n",
    "#B2C conditions:\n",
    "conditionsB2C=[\n",
    "    #Categories for B class:\n",
    "    (df_B2C[\"ABC_category\"] == \"B\") & (df_B2C[\"R_score\"]>4) & (df_B2C[\"F_score\"]>=4), #active customers with high frequency.\n",
    "    (df_B2C[\"ABC_category\"] == \"B\") & (df_B2C[\"R_score\"]>4) & (df_B2C[\"F_score\"]<4), #active customers with low frequency.\n",
    "    (df_B2C[\"ABC_category\"] == \"B\") & (df_B2C[\"R_score\"]<=4), #passive customers.\n",
    "    #Categories for C class:\n",
    "    (df_B2C[\"ABC_category\"] == \"C\") & (df_B2C[\"R_score\"]>4) & (df_B2C[\"F_score\"]>=4), #active customers with high frequency.\n",
    "    (df_B2C[\"ABC_category\"] == \"C\") & (df_B2C[\"R_score\"]>4) & (df_B2C[\"F_score\"]<4), #active customers with low frequency.\n",
    "    (df_B2C[\"ABC_category\"] == \"C\") & (df_B2C[\"R_score\"]<=4), #passive customers.\n",
    "]\n",
    "\n",
    "#B2B conditions:\n",
    "conditionsB2B=[\n",
    "    #Categories for A class:\n",
    "    (df_B2B[\"ABC_category\"] == \"A\") & (df_B2B[\"R_score\"]>4) & (df_B2B[\"F_score\"]>=4), #active customers with high frequency.\n",
    "    (df_B2B[\"ABC_category\"] == \"A\") & (df_B2B[\"R_score\"]>4) & (df_B2B[\"F_score\"]<4), #active customers with low frequency.\n",
    "    (df_B2B[\"ABC_category\"] == \"A\") & (df_B2B[\"R_score\"]<=4), #passive customers.\n",
    "    #Categories for B class:\n",
    "    (df_B2B[\"ABC_category\"] == \"B\") & (df_B2B[\"R_score\"]>4) & (df_B2B[\"F_score\"]>=4), #active customers with high frequency.\n",
    "    (df_B2B[\"ABC_category\"] == \"B\") & (df_B2B[\"R_score\"]>4) & (df_B2B[\"F_score\"]<4), #active customers with low frequency.\n",
    "    (df_B2B[\"ABC_category\"] == \"B\") & (df_B2B[\"R_score\"]<=4), #passive customers.\n",
    "    #Categories for C class:\n",
    "    (df_B2B[\"ABC_category\"] == \"C\") & (df_B2B[\"R_score\"]>4) & (df_B2B[\"F_score\"]>=4), #active customers with high frequency.\n",
    "    (df_B2B[\"ABC_category\"] == \"C\") & (df_B2B[\"R_score\"]>4) & (df_B2B[\"F_score\"]<4), #active customers with low frequency.\n",
    "    (df_B2B[\"ABC_category\"] == \"C\") & (df_B2B[\"R_score\"]<=4), #passive customers.\n",
    "]\n",
    "#Next we need to define categories for the conditions.\n",
    "#categories for B2C:\n",
    "categoriesB2C=[\"B:Active_HighF\", \"B:Active_LowF\", \"B:passive\", \"C:Active_HighF\", \"C:Active_LowF\", \"C:passive\"]\n",
    "#Categories for B2B:\n",
    "categoriesB2B=[\"A:Active_HighF\", \"A:Active_LowF\", \"A:passive\", \"B:Active_HighF\", \"B:Active_LowF\", \"B:passive\", \"C:Active_HighF\", \"C:Active_LowF\", \"C:passive\"]\n",
    "#Lets add RFM categories columns to the dataframes.\n",
    "df_B2C[\"RFM_categories\"]=np.select(conditionsB2C, categoriesB2C, default=None)\n",
    "df_B2B[\"RFM_categories\"]=np.select(conditionsB2B, categoriesB2B, default=None)\n",
    "print(\"B2C:\")\n",
    "print(df_B2C[\"RFM_categories\"].value_counts(dropna=False))\n",
    "print(\"B2B:\")\n",
    "print(df_B2B[\"RFM_categories\"].value_counts(dropna=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "506b7553-723c-46b6-b856-59ef6a99bedd",
   "metadata": {},
   "source": [
    "Customer is active if last purchase is made in the last 149 days and passive if over. Customer has HighF if they have done more then 4 purchases and low if less."
   ]
  },
